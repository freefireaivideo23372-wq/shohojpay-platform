<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7FA">

    <!-- Top App Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ ShohojPay"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#059669" />
            <TextView
                android:id="@+id/subHeaderText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto SMS Payment Sync Active"
                android:textSize="12sp"
                android:textColor="#64748B" />
        </LinearLayout>

        <Button
            android:id="@+id/syncNowBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="↻ SYNC"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0284C7" />
    </LinearLayout>

    <!-- Main Scrollable Content Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- 5-Tab Bottom Navigation Bar (Matches ZiniPay!) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/tabDashboard"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Dashboard"
            android:textSize="10sp"
            android:textAllCaps="false"
            android:background="@android:color/transparent"
            android:textColor="#059669" />

        <Button
            android:id="@+id/tabProviders"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Providers"
            android:textSize="10sp"
            android:textAllCaps="false"
            android:background="@android:color/transparent"
            android:textColor="#64748B" />

        <Button
            android:id="@+id/tabBalance"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Balance"
            android:textSize="10sp"
            android:textAllCaps="false"
            android:background="@android:color/transparent"
            android:textColor="#64748B" />

        <Button
            android:id="@+id/tabInsights"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Insights"
            android:textSize="10sp"
            android:textAllCaps="false"
            android:background="@android:color/transparent"
            android:textColor="#64748B" />

        <Button
            android:id="@+id/tabConfig"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="Config"
            android:textSize="10sp"
            android:textAllCaps="false"
            android:background="@android:color/transparent"
            android:textColor="#64748B" />
    </LinearLayout>
</LinearLayout>
