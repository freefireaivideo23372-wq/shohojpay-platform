<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F8FAFC">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ShohojPay (সহজপে)"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#059669" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="অটো bKash / Nagad / Rocket SMS ভেরিফিকেশন অ্যাপ"
        android:textSize="14sp"
        android:textColor="#475569"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="আপনার ড্যাশবোর্ড API Key দিন:"
        android:textStyle="bold"
        android:textColor="#0F172A" />

    <EditText
        android:id="@+id/apiKeyInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="sp_live_..."
        android:background="#FFFFFF"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/saveBtn"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="অটো ভেরিফিকেশন চালু করুন"
        android:textColor="#FFFFFF"
        android:backgroundTint="#059669"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="স্ট্যাটাস: API Key দিয়ে চালু করুন"
        android:textColor="#0F172A"
        android:textSize="14sp"
        android:layout_marginTop="20dp" />

</LinearLayout>
